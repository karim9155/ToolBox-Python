# ============================================================================
# Toolbox API Environment Variables - Example Configuration
# Copy this file to .env and fill in your actual values
# ============================================================================

# Google Cloud TTS API Key
# Get your key from: https://console.cloud.google.com/apis/credentials
GOOGLE_TTS_API_KEY=your-google-tts-api-key-here

# AssemblyAI API Key
# Get your key from: https://www.assemblyai.com/app/account
ASSEMBLYAI_API_KEY=your-assemblyai-api-key-here

# ============================================================================
# Async Callback Configuration (for Next.js App Integration)
# ============================================================================

# Callback Authentication Secret
# MUST match the secret in your Next.js app (TOOLBOX_CALLBACK_SECRET)
# Generate with: openssl rand -hex 32
TOOLBOX_CALLBACK_SECRET=your-callback-secret-here

# Allowed Callback Domains
# Comma-separated list of domains that can receive callbacks
# Include: localhost (dev), preprod domain, production domain
ALLOWED_CALLBACK_DOMAINS=127.0.0.1,localhost,preprod.yourdomain.com,yourdomain.com

# Callback Timeout (seconds)
# Maximum time to wait for callback response before timing out
CALLBACK_TIMEOUT=30

# Maximum Callback Retries
# Number of retry attempts if callback fails (with exponential backoff: 1s, 5s, 15s)
MAX_CALLBACK_RETRIES=3
